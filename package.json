{
  "name": "bpce-api-guidelines-rulesets",
  "version": "1.0.0",
  "description": "OAS3/Swagger2.0 Rulesets files compliant with BPCE/Natixis API Design guidelines",
  "main": "index.js",
  "scripts": {
    "pretest": "npx --yes prettier . --write --config-precedence file-override",
    "test": "standard \"{rulesets,test}/**/*.{mjs,js}\" && mocha --reporter mocha-junit-reporter",
    "alltests": "standard --fix \"{rulesets,test}/**/*.{mjs,js}\" && mocha",
    "infotest": "mocha test/test-info-ruleset.js",
    "pathtest": "mocha test/test-path-ruleset.js",
    "modelresponsetest": "mocha test/test-model-response-ruleset.js",
    "basepathtest": "mocha test/test-basepath-ruleset.js",
    "datatypestest": "mocha test/test-datatypes-ruleset.js",
    "httpmethodtest": "mocha test/test-http-method-ruleset.js",
    "doctest": "mocha test/test-documentation-ruleset.js",
    "modeltest": "mocha test/test-model-ruleset.js",
    "arazzotest": "mocha test/test-arazzo-ruleset.js"
  },
  "author": "Groupe BPCE",
  "license": "Apache-2.0",
  "contributor": [
    "Arnaud Lauret",
    "Aurélien Ianni",
    "Eric Salvan"
  ],
  "devDependencies": {
    "@stoplight/spectral-core": "^1.20.0",
    "@stoplight/spectral-ruleset-bundler": "^1.6.3",
    "@stoplight/spectral-rulesets": "^1.22.0",
    "ajv": "^8.17.1",
    "jsonpath-plus": "^10.3.0",
    "mocha": "*",
    "mocha-junit-reporter": "*",
    "prettier": "3.7.4",
    "standard": "*",
    "tslib": "^2.8.1"
  },
  "standard": {
    "globals": [
      "describe",
      "context",
      "before",
      "beforeEach",
      "after",
      "afterEach",
      "it",
      "expect"
    ],
    "ignore": [
      "node_modules/**",
      "rulesets/imported/**"
    ]
  }
}
